# ==============================================================================
# OUTMATE GTM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in the values corresponding to your setup.
# DO NOT commit real secrets or credentials into version control.
#
# Execution Mode Mapping:
# - Mode A (Standalone Python AI Agent): Requires OPENROUTER_* and SEARCH_*
# - Mode B (Claude.ai Custom Connector): Requires MCP_* and SEARCH_*
# - Third-Party CRM Proxy (HubSpot/Salesforce): Requires NANGO_*
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE SETTINGS (Shared across all modes)
# ------------------------------------------------------------------------------
APP_NAME="Outmate GTM"
# Allowed values: development, staging, production, test
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Allowed values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. OPENROUTER CONFIGURATION (Required for Mode A: Standalone AI Agent)
# ------------------------------------------------------------------------------
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model identifier (e.g., openai/gpt-4o-mini, openai/gpt-4o, meta-llama/llama-3.3-70b-instruct)
OPENROUTER_MODEL=openai/gpt-4o-mini
# Request timeout in seconds
OPENROUTER_TIMEOUT=60.0
# Automatic retry attempts for network/rate limit issues
OPENROUTER_MAX_RETRIES=3
# Optional max completion tokens (e.g. 1024, 2048, or leave empty for model default)
OPENROUTER_MAX_TOKENS=
# Model temperature (0.0 for deterministic outputs, up to 2.0)
OPENROUTER_TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# 3. NANGO INTEGRATION CONFIGURATION (OAuth Connection & Third-Party CRM Proxy)
# ------------------------------------------------------------------------------
# Nango handles third-party OAuth flows and secure API proxy requests ONLY.
# It is NOT used for AI orchestration or MCP server hosting.
# Dashboard: https://app.nango.dev
NANGO_SECRET_KEY=
NANGO_BASE_URL=https://api.nango.dev
NANGO_INTEGRATION_ID_HUBSPOT=hubspot
NANGO_CONNECT_SESSION_ENABLED=true
NANGO_TIMEOUT=30.0
# Optional default connection/integration identifiers for testing CRM exports (e.g. HubSpot)
NANGO_CONNECTION_ID=
NANGO_INTEGRATION_ID=hubspot

# HubSpot CRM Integration Flags & Guardrails
HUBSPOT_INTEGRATION_ENABLED=true
HUBSPOT_READ_ONLY=true
INTEGRATION_CONNECTION_TIMEOUT_SECONDS=30.0
INTEGRATION_REQUEST_TIMEOUT_SECONDS=30.0
INTEGRATION_MAX_RETRIES=3
OUTMATE_PUBLIC_BASE_URL=http://localhost:8000
OUTMATE_FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. RESEARCH / SEARCH PROVIDER (Used by Shared Services Layer)
# ------------------------------------------------------------------------------
# Supported search providers: exa, serper, tavily, mock
SEARCH_PROVIDER=exa
SEARCH_API_KEY=
# Optional custom base URL if self-hosting or using a regional proxy
SEARCH_API_BASE_URL=
SEARCH_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# 5. MODEL CONTEXT PROTOCOL (MCP) CONFIGURATION (Mode B & Remote Claude.ai)
# ------------------------------------------------------------------------------
# Primary server transport: 'streamable_http' (recommended for Claude.ai) or 'stdio' (local)
MCP_TRANSPORT=streamable_http
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_ENDPOINT=/mcp
MCP_SERVER_NAME=outmate-gtm-server
# Authentication strategy: 'none' (local dev), 'bearer' (Claude personal connector), 'oidc' (SaaS OAuth 2.1)
MCP_AUTH_MODE=none
# Static Bearer token configured in Claude.ai custom connector (when MCP_AUTH_MODE=bearer)
MCP_BEARER_TOKEN=
MCP_AUTH_ENABLED=false
MCP_AUTH_TOKEN=
# OIDC / OAuth 2.1 Resource Server configuration (when MCP_AUTH_MODE=oidc)
MCP_OAUTH_ISSUER_URL=
MCP_RESOURCE_SERVER_URL=https://api.outmate.ai/mcp
MCP_TOOL_TIMEOUT=45.0
MCP_REQUEST_TIMEOUT=60.0

# ------------------------------------------------------------------------------
# 6. SECURITY & NETWORKING
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS (wildcards forbidden in production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_KEY_REQUIRED=false

# ------------------------------------------------------------------------------
# 7. TESTING
# ------------------------------------------------------------------------------
# Set to true during test runs to mock external side-effects
TESTING=false

